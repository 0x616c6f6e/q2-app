{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q2:app:manifest:2",
  "title": "Q2-App manifest API 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "name",
    "version",
    "type",
    "entry",
    "api",
    "capabilities",
    "resources"
  ],
  "properties": {
    "format": {
      "const": 2
    },
    "api": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "version": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "entry": {
      "const": "main.lua"
    },
    "type": {
      "const": "app"
    },
    "icon": {
      "type": "string",
      "pattern": "^assets/(?!.*\\.\\.)[A-Za-z0-9_./-]+$",
      "maxLength": 96
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.]{1,47}$"
          }
        },
        "optional": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.]{1,47}$"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lua_heap_kib"
      ],
      "properties": {
        "lua_heap_kib": {
          "type": "integer",
          "minimum": 32,
          "maximum": 384
        }
      }
    },
    "dynamic_resources": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 256
    },
    "ota": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 256
    },
    "supported_resolutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:6[4-9]|[7-9][0-9]|[1-9][0-9]{2}|10[01][0-9]|102[0-4])x(?:6[4-9]|[7-9][0-9]|[1-9][0-9]{2}|10[01][0-9]|102[0-4])(?![\\s\\S])"
      },
      "description": "Supported full logical display sizes, width x height. Omission is legacy/unspecified; metadata does not block launch."
    }
  }
}
